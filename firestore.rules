rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membershipId(tenantId) { return tenantId + "_" + request.auth.uid; }
    function membershipExists(tenantId) { return signedIn() && exists(/databases/$(database)/documents/memberships/$(membershipId(tenantId))); }
    function membership(tenantId) { return get(/databases/$(database)/documents/memberships/$(membershipId(tenantId))); }
    function activeMember(tenantId) { return tenantActive(tenantId) && membershipExists(tenantId) && membership(tenantId).data.status == "active"; }
    function tenantRole(tenantId, roles) { return activeMember(tenantId) && membership(tenantId).data.role in roles; }
    function isPlatformOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data.role == "platform_owner"
        && get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data.status == "active";
    }
    function tenantActive(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId))
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.status == "active";
    }
    function commercialWriteAllowed(tenantId, feature) {
      let tenant = get(/databases/$(database)/documents/tenants/$(tenantId)).data;
      let legacy = !("commercial" in tenant);
      return tenant.status == "active" && (legacy ||
        (
          (
            tenant.commercial.subscriptionStatus == "active" ||
            (tenant.commercial.subscriptionStatus == "demo" && tenant.kind == "demo" && tenant.commercial.planId == "premium_demo") ||
            (tenant.commercial.subscriptionStatus == "trial" && request.time.toMillis() < tenant.commercial.get("trialUntilEpochMs", 0))
          )
          && (!("entitlementOverrides" in tenant.commercial)
            || !(feature in tenant.commercial.entitlementOverrides)
            || tenant.commercial.entitlementOverrides[feature] == true)
        ));
    }
    function professionalOwnsAppointment(tenantId) {
      return tenantRole(tenantId, ["professional"])
        && membership(tenantId).data.professionalId == resource.data.professionalId;
    }

    match /tenantSlugs/{slug} {
      allow read: if resource.data.status == "active" || isPlatformOwner();
      allow write: if isPlatformOwner();
    }

    match /tenants/{tenantId} {
      allow get: if resource.data.status == "active" || activeMember(tenantId) || isPlatformOwner();
      allow list: if isPlatformOwner();
      // Tenant lifecycle/commercial assignment requires trusted Worker + atomic audit.
      allow create, update, delete: if false;

      match /services/{serviceId} {
        allow read: if tenantActive(tenantId) && resource.data.active == true || activeMember(tenantId) || isPlatformOwner();
        allow create: if (tenantRole(tenantId, ["tenant_owner", "tenant_admin"]) || isPlatformOwner())
          && commercialWriteAllowed(tenantId, "services.manage")
          && request.resource.data.tenantId == tenantId
          && request.resource.data.priceCents is int && request.resource.data.priceCents >= 0
          && request.resource.data.durationMin is int && request.resource.data.durationMin > 0;
        allow update: if (tenantRole(tenantId, ["tenant_owner", "tenant_admin"]) || isPlatformOwner())
          && commercialWriteAllowed(tenantId, "services.manage")
          && request.resource.data.tenantId == tenantId
          && request.resource.data.priceCents is int && request.resource.data.priceCents >= 0
          && request.resource.data.durationMin is int && request.resource.data.durationMin > 0;
        allow delete: if false;
      }

      match /professionals/{professionalId} {
        allow read: if tenantActive(tenantId) && resource.data.active == true || activeMember(tenantId) || isPlatformOwner();
        // Quota counting cannot be enforced by client Rules alone. All mutations use trusted Worker.
        allow write: if false;
      }

      match /appointments/{appointmentId} {
        allow create: if false;
        // Customer queries must include customerId == verified customer membership ID.
        allow read: if tenantRole(tenantId, ["tenant_owner", "tenant_admin"])
          || professionalOwnsAppointment(tenantId)
          || (tenantRole(tenantId, ["customer"])
            && resource.data.get("customerId","") == membership(tenantId).data.customerId)
          || isPlatformOwner();
        // Status changes must update bookingLocks consistently in a trusted layer.
        allow update: if false;
        allow delete: if false;
      }

      match /bookingLocks/{lockId} {
        allow read: if tenantRole(tenantId, ["tenant_owner", "tenant_admin", "professional"]) || isPlatformOwner();
        allow write: if false;
      }

      match /customers/{customerId} {
        allow read: if tenantRole(tenantId, ["tenant_owner", "tenant_admin", "professional"])
          || (tenantRole(tenantId, ["customer"])
            && membership(tenantId).data.customerId == customerId)
          || isPlatformOwner();
        // Customer membership and customer records are created only by trusted Worker.
        allow create, update, delete: if false;
      }

      match /scheduleBlocks/{blockId} {
        allow read: if activeMember(tenantId) || isPlatformOwner();
        // Only trusted Worker can check existing appointments and atomically audit changes.
        allow create, update, delete: if false;
      }

      match /mediaRemovalRequests/{requestId} {
        // Removal requests contain user privacy reasons and require trusted Worker review.
        allow read, create, update, delete: if false;
      }

      match /invitations/{invitationId} {
        // Invitation secrets/email and staff role assignment are Worker-only.
        // Even tenant owner reads them only through controlled API workflows.
        allow read, create, update, delete: if false;
      }

      match /auditLogs/{logId} {
        allow read: if tenantRole(tenantId, ["tenant_owner"]) || isPlatformOwner();
        allow create: if isPlatformOwner()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.actorRole == "platform_owner"
          && request.resource.data.action == "platform.view_tenant"
          && request.resource.data.tenantId == tenantId;
        allow update, delete: if false;
      }
    }

    match /memberships/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isPlatformOwner());
      // Membership changes require trusted counters + audit, not direct client writes.
      allow create, update, delete: if false;
    }

    match /platformUsers/{uid} {
      allow read: if signedIn() && uid == request.auth.uid || isPlatformOwner();
      allow write: if false;
    }
  }
}
