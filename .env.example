# Firebase Web config. Não coloque secrets de servidor neste arquivo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# O app roda em DEMO LOCAL quando esta flag é true ou quando Firebase não está configurado.
VITE_DEMO_MODE=true
