# Firebase Web config (valores públicos do app Web; nunca coloque service-account aqui).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=manicure-6b7db
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true apenas para trabalhar com Firebase Emulator Suite local.
VITE_USE_FIREBASE_EMULATORS=false

# Demo local explícita. Quando true, somente o fluxo público usa dados locais fictícios.
# Áreas privadas continuam sem sessão fake e exigem Firebase Auth real.
VITE_DEMO_MODE=false

# Worker confiável para criação de agendamento.
VITE_BOOKING_API_BASE_URL=http://127.0.0.1:8787
